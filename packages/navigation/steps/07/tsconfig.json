{
  "compilerOptions": {
    "target": "es2023",
    "types": [
      "node",
      "@openui5/types"
    ],
    "skipLibCheck": true,
    "allowJs": true,
    "strictPropertyInitialization": false,
    "rootDir": "./webapp",
    "paths": {
      "ui5/tutorial/navigation/*": [
        "./webapp/*"
      ]
    },
    "strict": false,
    "strictNullChecks": false
  },
  "exclude": [
    "./webapp/test/e2e/**/*"
  ],
  "include": [
    "./webapp/**/*"
  ]
}
