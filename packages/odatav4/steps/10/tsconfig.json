{
  "compilerOptions": {
    "target": "es2023",
    "types": [
      "@openui5/types"
    ],
    "skipLibCheck": true,
    "allowJs": true,
    "strictPropertyInitialization": false,
    "rootDir": "./webapp",
    "paths": {
      "ui5/tutorial/odatav4/*": [
        "./webapp/*"
      ]
    },
    "strict": false,
    "strictNullChecks": false
  },
  "include": [
    "./webapp/**/*"
  ]
}
